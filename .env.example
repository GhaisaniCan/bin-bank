# Salin berkas ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# Berkas .env TIDAK ikut ter-commit (lihat .gitignore).

# ---------------------------------------------------------------------------
# MONGO_URI — connection string MongoDB. Dibaca di config/db.js
#
# WAJIB memakai MongoDB Atlas (replica set), bukan mongodb lokal berdiri sendiri.
# Modul Setoran & Buku Besar memakai transaksi database (session.withTransaction)
# untuk menjamin setoran dan penambahan saldo terjadi bersamaan, dan transaksi
# hanya berjalan di replica set. Atlas tier gratis (M0) sudah memenuhi syarat.
#
# Contoh:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/binbank?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGO_URI=

# ---------------------------------------------------------------------------
# JWT_SECRET — kunci penanda tangan token login.
# Dibaca di services/authService.js dan middlewares/authenticate.js
#
# Isi dengan teks acak yang panjang. Buat cepat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# PORT — port server Express. Dibaca di server.js
# Boleh dikosongkan; bila kosong server memakai 5001.
# ---------------------------------------------------------------------------
PORT=5001
