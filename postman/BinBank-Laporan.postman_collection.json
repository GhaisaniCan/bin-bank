{
  "info": {
    "name": "BinBank — Uji Jenis Sampah (Modul B)",
    "description": "Pengujian CRUD dan Soft Delete Jenis Sampah.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "tokenAdmin", "value": "" }
  ],
  "item": [
    {
      "name": "01 — Tambah Jenis Sampah",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Kardus Bekas\",\n  \"hargaPerKg\": 2500\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/jenis-sampah",
          "host": ["{{baseUrl}}"],
          "path": ["jenis-sampah"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Status sukses: true', () => pm.expect(body).to.have.property('sukses', true));",
              "if (body.sukses && body.data && body.data._id) {",
              "    pm.environment.set('jenisSampahId', body.data._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Lihat Daftar Jenis Sampah",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/jenis-sampah",
          "host": ["{{baseUrl}}"],
          "path": ["jenis-sampah"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Data berupa array', () => pm.expect(body.data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Ubah Harga & Nama (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nama\": \"Kardus Bekas Premium\",\n  \"hargaPerKg\": 3000\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/jenis-sampah/{{jenisSampahId}}",
          "host": ["{{baseUrl}}"],
          "path": ["jenis-sampah", "{{jenisSampahId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Harga berhasil diubah', () => pm.expect(body.data.hargaPerKg).to.eql(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Nonaktifkan Status (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"aktif\": false\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/jenis-sampah/{{jenisSampahId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["jenis-sampah", "{{jenisSampahId}}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Status aktif menjadi false', () => pm.expect(body.data.aktif).to.eql(false));"
            ]
          }
        }
      ]
    }
  ]
}