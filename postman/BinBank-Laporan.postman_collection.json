{
  "info": {
    "name": "BinBank — Uji Laporan (Modul B)",
    "description": "Pengujian Endpoint GET /laporan khusus role Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "tokenPetugas", "value": "" }
  ],
  "item": [
    {
      "name": "01 — Dapatkan Laporan (Keseluruhan)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/laporan",
          "host": ["{{baseUrl}}"],
          "path": ["laporan"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Data berhasil dikelompokkan', () => {",
              "    pm.expect(body.data).to.have.property('setoran');",
              "    pm.expect(body.data).to.have.property('penarikan');",
              "    pm.expect(body.data).to.have.property('saldo');",
              "});",
              "pm.test('Total nilai berbentuk angka', () => pm.expect(body.data.setoran.totalNilai).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Dapatkan Laporan (Filter Tanggal)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/laporan?dari=2026-09-01&sampai=2026-09-30",
          "host": ["{{baseUrl}}"],
          "path": ["laporan"],
          "query": [
            { "key": "dari", "value": "2026-09-01" },
            { "key": "sampai", "value": "2026-09-30" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Respon memiliki pesan sukses', () => pm.expect(pm.response.json().sukses).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Dapatkan Laporan (Ditolak: Bukan Admin)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{tokenPetugas}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/laporan",
          "host": ["{{baseUrl}}"],
          "path": ["laporan"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}